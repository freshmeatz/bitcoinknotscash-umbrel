#!/usr/bin/env bash
# Injects the xBTC node's RPC connection into datum_gateway_config.json before DATUM starts,
# and fixes the config file permissions so the uid-1000 DATUM container can read/write it.
# APP_BITCOIN_NODE_IP / APP_BITCOIN_RPC_PORT / APP_BITCOIN_RPC_USER / APP_BITCOIN_RPC_PASS
# are exported by the xbtc-node ("bitcoin") dependency's exports.sh.
set -euo pipefail

SETTINGS_DIR="${APP_DATA_DIR}/data/settings"
CONF="${SETTINGS_DIR}/datum_gateway_config.json"
SAMPLE="${SETTINGS_DIR}/datum_gateway_config.sample.json"

mkdir -p "${SETTINGS_DIR}"

# Seed from the shipped sample on first run.
if [[ ! -f "${CONF}" && -f "${SAMPLE}" ]]; then
  cp "${SAMPLE}" "${CONF}"
fi
[[ -f "${CONF}" ]] || { echo "xbtc-datum: no datum_gateway_config.json to configure"; exit 0; }

# Rewrite the bitcoind section from the dependency's RPC details.
tmp="$(mktemp)"
jq \
  --arg url  "${APP_BITCOIN_NODE_IP}:${APP_BITCOIN_RPC_PORT}" \
  --arg user "${APP_BITCOIN_RPC_USER}" \
  --arg pass "${APP_BITCOIN_RPC_PASS}" \
  '.bitcoind.rpcurl = $url | .bitcoind.rpcuser = $user | .bitcoind.rpcpassword = $pass' \
  "${CONF}" > "${tmp}" && mv "${tmp}" "${CONF}"

# Give the dashboard a working admin login out of the box (username: admin). Only set it
# if it's still the shipped placeholder/empty, so a password you choose is never clobbered.
# Matches defaultUsername/defaultPassword in umbrel-app.yml. CHANGE IT in the Config tab.
cur_pw="$(jq -r '.api.admin_password // ""' "${CONF}")"
if [[ -z "${cur_pw}" || "${cur_pw}" == "<injected>" ]]; then
  tmp2="$(mktemp)"
  jq '.api.admin_password = "umbrelxbtc"' "${CONF}" > "${tmp2}" && mv "${tmp2}" "${CONF}"
fi

# CRITICAL: the datum container runs as uid 1000, but this hook runs as root and
# `mktemp`+`mv` above leaves CONF owned root:root mode 600 — and umbrel copies the
# seeded settings dir in as root too. Without this, the container gets
# "unable to open /app/conf/datum_gateway_config.json: Permission denied" and
# crash-loops. Make the dir traversable and the config readable+writable by uid 1000
# (writable so the DATUM admin "Config tab" can save). Runs every start, so it self-heals.
chown -R 1000:1000 "${SETTINGS_DIR}" 2>/dev/null || true
chmod 0755 "${SETTINGS_DIR}" 2>/dev/null || true
chmod 0644 "${CONF}" 2>/dev/null || true

echo "xbtc-datum: pointed DATUM at ${APP_BITCOIN_NODE_IP}:${APP_BITCOIN_RPC_PORT}"
